/* Telegram Sticker Maker 深色主题 */

* { outline: 0; }
QWidget { color: #e6e8ee; }
QWidget#Central { background: #14161b; }
QToolTip { background: #262a33; color: #e6e8ee; border: 1px solid #3a4050; padding: 4px 6px; }

/* 顶部标题栏 */
#HeaderBar { background: #1a1d24; border-bottom: 1px solid #262a33; }
#AppTitle { font-size: 18px; font-weight: 600; }
#AppSubtitle { color: #8b93a7; font-size: 12px; }
#Badge {
    background: rgba(42, 171, 238, 0.16); color: #6cc6f5;
    border: 1px solid rgba(42, 171, 238, 0.45); border-radius: 12px;
    padding: 4px 12px; font-size: 12px;
}
#Badge[muted="true"] { background: #22262e; color: #8b93a7; border-color: #323744; }

/* 按钮 */
QPushButton {
    background: #232731; border: 1px solid #323744; border-radius: 8px; padding: 6px 12px;
}
QPushButton:hover { background: #2a2f3b; border-color: #3f4658; }
QPushButton:pressed { background: #1f232c; }
QPushButton:disabled { color: #5c6375; background: #1c1f26; border-color: #282c36; }
QPushButton::menu-indicator { subcontrol-position: right center; right: 10px; }

QPushButton#PrimaryButton {
    background: #2aabee; border: none; color: white; border-radius: 10px;
    font-size: 15px; font-weight: 600;
}
QPushButton#PrimaryButton:hover { background: #3cb6f2; }
QPushButton#PrimaryButton:disabled { background: #24526b; color: #b8d4e3; }

QPushButton#DangerButton { color: #ff8a8b; border-color: #5a2f33; background: #2a1f23; }
QPushButton#DangerButton:hover { background: #3a2429; }
QPushButton#DangerButton:disabled { color: #5c6375; background: #1c1f26; border-color: #282c36; }
QPushButton#DangerGhostButton { color: #ff8a8b; }

QPushButton#SegmentButton { padding: 8px 6px; }
QPushButton#SegmentButton:checked {
    background: rgba(42, 171, 238, 0.18); border-color: #2aabee; color: #8fd3f7;
}
QPushButton#SmallButton { padding: 3px 10px; font-size: 11px; }

QToolButton { background: transparent; border: none; padding: 4px; }
QToolButton:hover { background: #262a33; border-radius: 6px; }

/* 输入控件 */
QLineEdit, QComboBox {
    background: #1a1d24; border: 1px solid #323744; border-radius: 6px; padding: 5px 8px;
    selection-background-color: #2aabee;
}
QLineEdit:focus, QComboBox:focus { border-color: #2aabee; }
QLineEdit:disabled, QComboBox:disabled { color: #5c6375; background: #181a20; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background: #1e2128; border: 1px solid #323744; selection-background-color: #2a3a4d; padding: 4px;
}
QCheckBox { spacing: 6px; }
QCheckBox::indicator { width: 14px; height: 14px; border-radius: 4px; border: 1px solid #4a5163; background: #1a1d24; }
QCheckBox::indicator:checked { background: #2aabee; border-color: #2aabee; }
QCheckBox::indicator:disabled { border-color: #323744; }

QProgressBar { background: #22262e; border: none; border-radius: 4px; }
QProgressBar::chunk { background: #2aabee; border-radius: 4px; }

QMenu { background: #1e2128; border: 1px solid #323744; padding: 4px; }
QMenu::item { padding: 6px 18px; border-radius: 4px; }
QMenu::item:selected { background: #2a3a4d; }
QMenu::item:disabled { color: #5c6375; }
QMenu::separator { height: 1px; background: #323744; margin: 4px 6px; }

QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #353b48; border-radius: 4px; min-height: 30px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #353b48; border-radius: 4px; min-width: 30px; }
QScrollBar::handle:hover { background: #454c5c; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* 空列表拖放区 */
#DropZone { background: #181b21; border: 2px dashed #323744; border-radius: 14px; }
#DropIcon { font-size: 44px; }
#DropTitle { font-size: 20px; font-weight: 600; }
#DropHint { color: #8b93a7; }
#FormatTag { background: #22262e; color: #9aa3b8; border-radius: 6px; padding: 2px 8px; font-size: 11px; }

/* 任务列表 */
QTableView#TaskTable {
    background: #181b21; border: 1px solid #262a33; border-radius: 10px;
    selection-background-color: #23384d; selection-color: #e6e8ee;
}
QTableView#TaskTable::item { border-bottom: 1px solid #22262e; padding: 4px 6px; }
QTableView#TaskTable::item:selected { background: #23384d; }
QHeaderView::section {
    background: #1e2128; color: #8b93a7; border: none; border-bottom: 1px solid #2c313c;
    padding: 6px 8px; font-weight: 600;
}

/* 右侧面板 */
#Section { background: #1b1e25; border: 1px solid #262a33; border-radius: 10px; }
#SectionTitle { font-weight: 600; font-size: 13px; }
#Hint { color: #8b93a7; font-size: 11px; }
#PathLabel { color: #6cc6f5; font-size: 11px; }
#ProgressCard { background: #1b2430; border: 1px solid #27445c; border-radius: 10px; }

/* 底部日志 */
#LogPanel { background: #1a1d24; border-top: 1px solid #262a33; }
#LogToggle { font-weight: 600; }
#LogSummary { color: #8b93a7; padding-left: 8px; }
QPlainTextEdit#LogView {
    background: #121418; border: none; border-top: 1px solid #262a33; color: #c3c9d6;
    selection-background-color: #2aabee;
}

/* 截取 / 裁切编辑窗口 */
QDialog { background: #14161b; }
#TimelineBox, #CropBar { background: #1b1e25; border: 1px solid #262a33; border-radius: 10px; }
#TimeLabel { font-family: Consolas, monospace; font-size: 13px; font-weight: 600; color: #6cc6f5; }
#Hint[warning="true"] { color: #f5a623; }
QPushButton#ProxyButton[state="ok"] { color: #3ecf8e; border-color: #2c5a45; }
QPushButton#ProxyButton[state="error"] { color: #ff8a8b; border-color: #5a2f33; }
QPushButton:checked { background: rgba(42, 171, 238, 0.18); border-color: #2aabee; color: #8fd3f7; }

#ClipPanel { background: #181b21; border: 1px solid #262a33; border-radius: 10px; }
#ClipCard { background: #1e2129; border: 1px solid #2a2f3a; border-radius: 10px; }
#ClipCard:hover { border-color: #3a4152; }
#ClipCard[selected="true"] { border: 1px solid #2aabee; background: #1d2a38; }
#ClipIndex { color: white; border-radius: 11px; font-weight: 600; font-size: 11px; }
#ClipThumb { background: #12141a; border-radius: 6px; }
#ClipDuration { color: #9aa3b8; font-size: 11px; }
#ClipDuration[missing="true"] { color: #f5a623; }

QSlider::groove:horizontal { height: 4px; background: #2c313c; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #2aabee; border-radius: 2px; }
QSlider::handle:horizontal { width: 14px; height: 14px; margin: -5px 0; border-radius: 7px; background: #e6e8ee; }
QSlider:disabled::sub-page:horizontal { background: #3a4050; }
QDoubleSpinBox { background: #1a1d24; border: 1px solid #323744; border-radius: 6px; padding: 4px 6px; }

/* 关键词弹窗 */
#DialogTitle { font-size: 16px; font-weight: 600; }
#ChipBox { background: #1a1d24; border: 1px solid #2c313c; border-radius: 10px; }
#Chip { background: rgba(42, 171, 238, 0.16); border: 1px solid rgba(42, 171, 238, 0.45); border-radius: 13px; }
#Chip QLabel { color: #cfe9fb; }
QToolButton#ChipClose { color: #8fb8d4; font-size: 10px; padding: 0 4px; border-radius: 8px; }
QToolButton#ChipClose:hover { background: rgba(255, 255, 255, 0.12); color: white; }
#Counter { color: #8b93a7; font-family: Consolas, monospace; }
#Counter[full="true"] { color: #f5a623; font-weight: 600; }
